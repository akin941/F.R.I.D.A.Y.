# Jarvis OS — environment template. Copy to .env and fill in. NEVER commit real secrets.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# From the host: postgres://jarvis:jarvis@localhost:5433/jarvis (Compose maps 5433->5432)
DATABASE_URL=

# From the host: redis://localhost:6380/0 (Compose maps 6380->6379)
REDIS_URL=

# Celery eager mode (MVP 2 §4) — leave unset/false for `make up` and normal
# dev so the worker container genuinely processes tasks out-of-process.
# Only the backend test suite and e2e CI set these to true (see
# backend/conftest.py), so a task dispatched via transaction.on_commit runs
# inline without needing a live broker.
CELERY_TASK_ALWAYS_EAGER=
CELERY_TASK_EAGER_PROPAGATES=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# LLM providers (all calls go through ai_core gateway — MVP 1+)
# Deterministic fake provider for dev/tests — never enable in production.
AI_FAKE_PROVIDER=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

SENTRY_DSN=

# Auth / API
SIGNUP_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Absolute path to the Obsidian vault (human-readable memory mirror,
# ADR-005). MVP 5 §3: actually consumed by the vault_export tool. Must be
# absolute, not "/", and not the home directory or one of its ancestors
# (validated at request time with zero filesystem access; whether it
# actually exists as a directory is checked separately, in the worker
# container only, at export time — see deploy/docker/compose.yml's
# OBSIDIAN_VAULT_HOST_PATH bind mount for the dev stack).
OBSIDIAN_VAULT_PATH=

# Approval gate (ADR-004, MVP 5). Hours a pending ApprovalRequest may sit
# undecided before it expires.
APPROVAL_REQUEST_TTL_HOURS=24

# DEV/TEST ONLY — never set true in a real deployment. Lets the same user
# both request and approve a gated action, bypassing ADR-004's requester !=
# decider rule. The process refuses to boot if this is true while
# DJANGO_DEBUG is false.
DEV_ALLOW_SELF_APPROVAL=false
