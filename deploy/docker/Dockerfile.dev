# Friday OS backend — development image only (MVP 0). No production hardening.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Keep the venv outside /app so the bind mount doesn't shadow it.
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy

# git: the reference node's fixture home (`nodes.reference.fixtures.factory`)
# creates git repos, so `run_reference_node` (runbook A3 baseline preflight)
# and preflight's `node_escape_suite` check crash without it in this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for layer caching.
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-install-project 2>/dev/null || uv sync --frozen

# Source code (shadowed by the compose bind mount during development).
COPY backend/ ./

EXPOSE 8000
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
