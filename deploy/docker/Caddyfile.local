# Loopback TLS front for a Friday Node on this Mac (compose.local-tls.yml).
# Only the node's three paths are forwarded; everything else is 404.
{
	admin off
	auto_https off
	persist_config off
	# Never touch any trust store (no internal CA is installed anywhere).
	skip_install_trust
	# A client that connects by IP sends no SNI: serve this certificate.
	default_sni 127.0.0.1
}

https://127.0.0.1:8443, https://localhost:8443, https://local-tls:8443 {
	tls /certs/cert.pem /certs/key.pem

	@gateway path /ws/node/v1
	handle @gateway {
		# Authorization and Sec-WebSocket-Protocol pass through unchanged;
		# Caddy adds no Origin header (the gateway closes on one, 4403).
		reverse_proxy node-gateway:8002
	}

	@node_api path /api/v1/nodes/pair /api/v1/auth/nodes/credential/rotate
	handle @node_api {
		reverse_proxy web:8000
	}

	handle {
		respond 404
	}
}
