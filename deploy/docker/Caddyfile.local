# Loopback TLS front for a Friday Node on this Mac (compose.local-tls.yml).
# Only the node's own paths are forwarded -- pairing, credential rotation,
# the node gateway, and the node voice flow (the host's voice-token mint plus
# the six views a node_voice token reaches, Phase 11 D4 / preflight
# voice_live_channel) -- everything else is 404.
# backend/ops/tests/test_local_tls_caddyfile.py guards this list.
#
# Matching: Caddy's `path` matcher is case-insensitive and compares the
# cleaned path (`//` merged, `%2f` decoded, `.`/`..` segments resolved), so
# e.g. /API/v1/voice/speech or /x/../api/v1/voice/speech is forwarded too.
# That is safe only because every name below is an exact, real route
# (asserted by the test) and Django is case-sensitive: any variant other
# than the exact path is a 404 upstream. No prefix or wildcard is ever used.
# The proxy adds no header of its own (no CORS, no Origin): Django's
# CORS/CSRF policy decides, unchanged.
{
	admin off
	auto_https off
	persist_config off
	# Never touch any trust store (no internal CA is installed anywhere).
	skip_install_trust
	# A client that connects by IP sends no SNI: serve this certificate.
	default_sni 127.0.0.1
}

https://127.0.0.1:8443, https://localhost:8443, https://local-tls:8443 {
	tls /certs/cert.pem /certs/key.pem

	@gateway path /ws/node/v1
	handle @gateway {
		# Authorization and Sec-WebSocket-Protocol pass through unchanged;
		# Caddy adds no Origin header (the gateway closes on one, 4403).
		reverse_proxy node-gateway:8002
	}

	@node_api path /api/v1/nodes/pair /api/v1/auth/nodes/credential/rotate
	handle @node_api {
		reverse_proxy web:8000
	}

	# The node voice flow (Phase 11): the Swift host mints the node_voice
	# token; the voice child (node/friday-voice/friday_voice/client.py)
	# opens the live session, transcribes, sends the chat turn, synthesizes
	# and reads the always-on policy; the receipt is the sixth D4 view.
	@node_voice path /api/v1/auth/nodes/voice-token /api/v1/auth/nodes/voice-policy /api/v1/voice/live/sessions /api/v1/voice/transcriptions /api/v1/voice/speech /api/v1/voice/receipt
	handle @node_voice {
		reverse_proxy web:8000
	}

	@node_voice_turn path_regexp ^/api/v1/ai/conversations/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/messages$
	handle @node_voice_turn {
		reverse_proxy web:8000
	}

	handle {
		respond 404
	}
}
