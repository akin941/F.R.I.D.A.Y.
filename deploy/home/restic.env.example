# Friday home server -- the HOST's restic environment file (Phase 13b D2,
# ADR-017 amendment 2; docs/runbooks/home-server-setup.md step 8 and I5).
#
# Copy to the host, mode 0600, owned by the user that runs the backup:
#   Linux (home PC):      /etc/friday-backup/restic.env
#   macOS (interim Mac):  ~/.config/friday-backup/restic.env
# deploy/home/friday-backup.sh sources it in a subshell only (FRIDAY_RESTIC_ENV).
#
# HOST-ONLY: never copy these into deploy/docker/.env or any compose file --
# no container may hold a key that can read or delete the backups
# (backend/ops/tests/test_no_bucket_secrets_in_compose.py). NAMES ONLY here;
# fill the values on the host. The defaults target Cloudflare R2 with a
# bucket-scoped "Object Read & Write" token.
#
# RESTIC_REPOSITORY: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#   -- no userinfo (`user:pass@`) and no `?query`: friday-backup.sh records
#   this value in status.json and refuses to run when it could carry a
#   credential. The same string goes into HOME_BACKUP_OFFSITE_REPOSITORY in
#   deploy/docker/.env, so preflight can check where the last backup went.
RESTIC_REPOSITORY=
# A file holding the restic repository password (0600; also in the owner's
# password manager), e.g. /etc/friday-backup/restic.pass.
RESTIC_PASSWORD_FILE=
# The R2 token's access key id and secret (S3 API credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 takes the region "auto".
AWS_DEFAULT_REGION=
