# Friday home server -- nightly encrypted backup (Phase 13 D14).
# Install: sudo install -m 0755 deploy/home/friday-backup.sh /usr/local/bin/friday-backup
#          sudo install -m 0644 deploy/home/friday-backup.{service,timer} /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now friday-backup.timer
# Runs as the `friday` user (member of the docker group). The script's
# locations default to the runbook's (FRIDAY_* variables in the script);
# override them with `systemctl edit friday-backup.service`.
[Unit]
Description=Friday nightly encrypted backup (pg_dump + age + restic)
Documentation=file:///srv/friday/friday/docs/runbooks/home-server-setup.md
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=friday
Group=friday
UMask=0077
ExecStart=/usr/local/bin/friday-backup
Nice=10
IOSchedulingClass=idle
# Hardening: the script needs the backup dir, its own config, the checkout
# (for `docker compose`) and the Docker socket; nothing else is writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/friday
ReadOnlyPaths=/etc/friday-backup /srv/friday
TimeoutStartSec=2h
# restic's cache (the home directory is hidden from the unit).
CacheDirectory=friday-backup
Environment=RESTIC_CACHE_DIR=/var/cache/friday-backup
