<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 11 M3 (runbook B8; docs/voice/live-eval.md §4): the nightly
  self-trigger run, 03:17 local time. A run missed while the Mac slept runs
  once at the next wake; selftest-nightly.sh skips it on battery.
  install-voice-selftest.sh renders @HOME@ and copies this file to
  ~/Library/LaunchAgents/ai.friday.voice-selftest.plist. Loading it is an
  owner step (it plays audio and opens the mic every night):
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.friday.voice-selftest.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.friday.voice-selftest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@HOME@/Library/Application Support/Friday/voice/selftest-nightly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>17</integer></dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <!-- Longer than the app's 30 s mint timeout: a SIGTERM that lands while
       the token mint runs still reaches the script's trap (which
       deletes the token) before launchd escalates to SIGKILL. -->
  <key>ExitTimeOut</key><integer>45</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/Friday/voice-selftest.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/Friday/voice-selftest.log</string>
</dict>
</plist>
