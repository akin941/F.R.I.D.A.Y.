<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 9 M1 entitlements (brief M1; the A1 Personal Team spike):
  hardened runtime only (a build setting, not a key), plus Keychain Sharing
  with one group = the app's own bundle id, which makes Xcode provision
  application-identifier / keychain-access-groups so the credential can
  live in the data protection keychain. No App Sandbox, no network
  entitlement (no effect unsandboxed), no server entitlement, no
  microphone (Phase 11).
  Phase 10 M2 (runbook B6): Apple Events, which the hardened runtime
  requires for the AppleScript recipes (osascript runs them with this app
  as the responsible process; every target app still asks the owner once,
  the Automation TCC prompt). Accessibility (AX press/type) is a TCC grant
  with no entitlement.
  Phase 11 M1 (runbook B7): the microphone, which the hardened runtime
  requires for AVAudioEngine capture (the voice host); the owner still
  grants it once (the Microphone TCC prompt, NSMicrophoneUsageDescription
  in Info.plist). Nothing else: no camera, no network server.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
