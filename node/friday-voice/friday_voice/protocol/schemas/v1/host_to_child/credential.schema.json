{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday-voice/v1/credential",
  "title": "credential",
  "description": "The short-lived node_voice token minted by the host with the node secret (brief D3), handed over on stdin only. ca_sha256 pins the server's CA (null only for a loopback http dev server).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "token",
    "expires_at",
    "server_url",
    "ca_sha256"
  ],
  "properties": {
    "type": {
      "type": "string",
      "maxLength": 16,
      "const": "credential"
    },
    "token": {
      "type": "string",
      "maxLength": 160,
      "pattern": "jpat_[A-Za-z0-9_-]{16,150}"
    },
    "expires_at": {
      "type": "string",
      "maxLength": 32,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)"
    },
    "server_url": {
      "type": "string",
      "maxLength": 270,
      "pattern": "https://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?|http://(127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?"
    },
    "ca_sha256": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "[0-9a-f]{64}"
    }
  }
}
