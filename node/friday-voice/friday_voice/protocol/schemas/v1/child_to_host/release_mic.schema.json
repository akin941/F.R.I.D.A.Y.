{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday-voice/v1/release_mic",
  "title": "release_mic",
  "description": "Fail closed: the host releases the microphone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "reason"
  ],
  "properties": {
    "type": {
      "type": "string",
      "maxLength": 16,
      "const": "release_mic"
    },
    "reason": {
      "type": "string",
      "maxLength": 24,
      "enum": [
        "link_down",
        "muted",
        "mute_unreadable",
        "mode_off",
        "credential_missing",
        "credential_expired",
        "credential_refused",
        "protocol_error",
        "stdin_closed",
        "storm",
        "shutdown",
        "error"
      ]
    }
  }
}
