{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "server -> node: counts for one event batch (never content)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dropped",
    "duplicate",
    "event_id",
    "id",
    "stored",
    "type",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 2
    },
    "type": {
      "type": "string",
      "const": "event.ack",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stored": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "duplicate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    }
  }
}
