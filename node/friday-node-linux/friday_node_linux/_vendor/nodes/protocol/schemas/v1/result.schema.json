{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node -> server: the answer to one invoke, or a frame-error report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration_ms",
    "id",
    "invocation_id",
    "output",
    "output_sha256",
    "refusal_code",
    "status",
    "truncated",
    "type",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "result",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "refused",
        "error",
        "timeout"
      ],
      "maxLength": 16
    },
    "refusal_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "too_large",
        "malformed",
        "unknown_type",
        "schema",
        "unknown_key",
        "bad_signature",
        "wrong_node",
        "not_yet_valid",
        "expired",
        "ttl_too_long",
        "replay",
        "nonce_cache_full",
        "unknown_capability",
        "class_not_allowed",
        "args_hash_mismatch",
        "args_schema",
        "not_granted",
        null
      ],
      "maxLength": 32
    },
    "output": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "x-friday-opaque": "validated against the capability's result_schema; at most 64 KiB canonical",
      "maxProperties": 64,
      "maxItems": 1024
    },
    "truncated": {
      "type": "boolean"
    },
    "output_sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^([0-9a-f]{64})?$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    }
  }
}
