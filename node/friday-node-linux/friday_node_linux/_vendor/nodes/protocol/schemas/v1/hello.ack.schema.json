{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "server -> node: session accepted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "heartbeat_seconds",
    "id",
    "node_id",
    "rotate_after_days",
    "server_time",
    "type",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "hello.ack",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "heartbeat_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "rotate_after_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "server_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "accepted": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,3}$"
      }
    }
  }
}
