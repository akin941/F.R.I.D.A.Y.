{
  "name": "codex.transcripts.owner_turns",
  "version": 1,
  "class": "read",
  "data_class": "personal",
  "description": "Owner-typed turns of Codex threads (thread_id as session_id) under the given cwd prefixes, scrubbed on the node; never assistant text, tool calls or tool results.",
  "path_args": [
    "cwd_prefixes"
  ],
  "workspace_resolution": "row_cwd",
  "max_result_bytes": 65536,
  "args_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cwd_prefixes",
      "max_sessions",
      "max_turns",
      "since"
    ],
    "properties": {
      "since": {
        "type": "string",
        "minLength": 20,
        "maxLength": 35,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "cwd_prefixes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?:/[^\\x00]*|~|~/[^\\x00]*)$"
        }
      },
      "max_sessions": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "max_turns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "next_since",
      "sessions",
      "truncated"
    ],
    "properties": {
      "sessions": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cwd",
            "session_id",
            "turns"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?:/[^\\x00]*|~|~/[^\\x00]*)$"
            },
            "turns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "text",
                  "turn_id"
                ],
                "properties": {
                  "turn_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "at": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 35
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        }
      },
      "next_since": {
        "type": "string",
        "minLength": 20,
        "maxLength": 35
      },
      "truncated": {
        "type": "boolean"
      }
    }
  }
}
