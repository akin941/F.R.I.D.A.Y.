{
  "name": "codex.threads.list",
  "version": 1,
  "class": "read",
  "data_class": "firm",
  "description": "Codex threads active in the last since_hours; metadata only, no text.",
  "path_args": [
    "cwd_prefixes"
  ],
  "workspace_resolution": "row_cwd",
  "max_result_bytes": 65536,
  "args_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "limit",
      "since_hours"
    ],
    "properties": {
      "since_hours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 168
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cwd_prefixes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^~?(?:/(?!\\.\\.?(?:/|$))[^/\\x00-\\x1f\\x7f\\u200b-\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff;|&$`<>\\\\*?\"'{}\\[\\]!]{1,255})+$"
        }
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "threads"
    ],
    "properties": {
      "threads": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cwd",
            "last_activity_at",
            "message_count",
            "model",
            "started_at",
            "status_hint",
            "thread_id"
          ],
          "properties": {
            "thread_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "cwd": {
              "type": "string",
              "minLength": 2,
              "maxLength": 1024,
              "pattern": "^~?(?:/(?!\\.\\.?(?:/|$))[^/\\x00-\\x1f\\x7f\\u200b-\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff;|&$`<>\\\\*?\"'{}\\[\\]!]{1,255})+$"
            },
            "started_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            "last_activity_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            "message_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,63}$"
            },
            "status_hint": {
              "type": "string",
              "enum": [
                "active",
                "idle",
                "ended",
                "unknown"
              ],
              "maxLength": 16
            }
          }
        }
      }
    }
  }
}
