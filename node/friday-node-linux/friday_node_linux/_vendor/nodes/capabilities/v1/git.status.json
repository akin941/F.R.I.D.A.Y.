{
  "name": "git.status",
  "version": 1,
  "class": "read",
  "data_class": "firm",
  "description": "Counts-only git state of one repo on the node's local list.",
  "path_args": [
    "repo_path"
  ],
  "workspace_resolution": "path_arg",
  "max_result_bytes": 4096,
  "args_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "repo_path"
    ],
    "properties": {
      "repo_path": {
        "type": "string",
        "minLength": 2,
        "maxLength": 1024,
        "pattern": "^~?(?:/(?!\\.\\.?(?:/|$))[^/\\x00-\\x1f\\x7f\\u200b-\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff;|&$`<>\\\\*?\"'{}\\[\\]!]{1,255})+$"
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ahead",
      "behind",
      "branch",
      "dirty_files_count",
      "last_commit_at",
      "last_commit_sha",
      "untracked_count"
    ],
    "properties": {
      "branch": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 255,
        "pattern": "^[^\\x00-\\x1f\\x7f]{1,255}$"
      },
      "ahead": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "behind": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "dirty_files_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "untracked_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "last_commit_sha": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 64,
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      },
      "last_commit_at": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 253402300799
      }
    }
  }
}
