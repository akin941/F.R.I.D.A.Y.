# GitHub connector sidecar (Phase 5 branch 5, brief D7, docs/mcp/github.md):
# the official github-mcp-server binary, pinned by digest, run in stdio mode
# as the child of the Friday stdio<->HTTP bridge. The PAT reaches only this
# container's environment (GITHUB_PERSONAL_ACCESS_TOKEN, passed to the child
# via BRIDGE_ENV_PASSTHROUGH); web and worker hold only GITHUB_MCP_URL.
# Bumping the digest is a reviewed commit that also re-records the schema
# pins in backend/connectors/manifests/github.py.
FROM ghcr.io/github/github-mcp-server:v1.12.2@sha256:508a0857ec762b1ab1cece29193345b501fab1dd9d1228a7b617062954cecac6 AS github

FROM python:3.12-slim

RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin bridge
# The same pinned SDK minor as the backend (backend/pyproject.toml).
RUN pip install --no-cache-dir "mcp>=2.2,<2.3" "uvicorn>=0.31"
COPY --from=github /server/github-mcp-server /server/github-mcp-server
COPY backend/connectors/__init__.py /app/connectors/__init__.py
COPY backend/connectors/docker/__init__.py /app/connectors/docker/__init__.py
COPY backend/connectors/docker/stdio_bridge.py /app/connectors/docker/stdio_bridge.py

WORKDIR /app
USER bridge
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
EXPOSE 8080
ENTRYPOINT ["python", "-m", "connectors.docker.stdio_bridge"]
