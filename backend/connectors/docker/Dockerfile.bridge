# Connector sidecar base: the stdio<->HTTP bridge (ADR-010 decision 3, D1).
# A stdio-only MCP server image builds FROM this (or copies its binary in)
# and sets BRIDGE_COMMAND / BRIDGE_ALLOWED_TOOLS / BRIDGE_ENV_PASSTHROUGH in
# its compose service. Pin the base by digest when a sidecar is added
# (`docker buildx imagetools inspect python:3.12-slim`), like every sidecar
# image a manifest names.
FROM python:3.12-slim

RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin bridge
# The same pinned SDK minor as the backend (backend/pyproject.toml).
RUN pip install --no-cache-dir "mcp>=2.2,<2.3" "uvicorn>=0.31"
COPY backend/connectors/__init__.py /app/connectors/__init__.py
COPY backend/connectors/docker/__init__.py /app/connectors/docker/__init__.py
COPY backend/connectors/docker/common.py /app/connectors/docker/common.py
COPY backend/connectors/docker/stdio_bridge.py /app/connectors/docker/stdio_bridge.py
# Phase 12 D9: the HTTP relay mode (compose `n8n-relay` overrides the
# entrypoint with `python -m connectors.docker.http_relay`).
COPY backend/connectors/docker/http_relay.py /app/connectors/docker/http_relay.py

WORKDIR /app
USER bridge
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
ENTRYPOINT ["python", "-m", "connectors.docker.stdio_bridge"]
