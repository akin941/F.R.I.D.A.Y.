{
  "name": "windows.list",
  "version": 1,
  "class": "read",
  "data_class": "personal",
  "description": "Applications with windows; titles only when the owner enabled them on the Mac.",
  "path_args": [],
  "workspace_resolution": "personal_only",
  "max_result_bytes": 65536,
  "args_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "limit"
    ],
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "windows"
    ],
    "properties": {
      "windows": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_name",
            "bundle_id",
            "on_screen",
            "window_count"
          ],
          "properties": {
            "bundle_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,254}$"
            },
            "app_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]{1,255}$"
            },
            "window_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "on_screen": {
              "type": "boolean"
            },
            "titles": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]{0,512}$"
              }
            }
          }
        }
      }
    }
  }
}
