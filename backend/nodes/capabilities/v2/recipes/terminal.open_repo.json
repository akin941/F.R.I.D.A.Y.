{
  "name": "terminal.open_repo",
  "version": 1,
  "label": "Terminalde aç",
  "description": "Yerel listedeki bir repoyu Terminal'de açar.",
  "params_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "repo_path"
    ],
    "properties": {
      "repo_path": {
        "type": "string",
        "minLength": 2,
        "maxLength": 1024,
        "pattern": "^~?(?:/(?!\\.\\.?(?:/|$))[^/\\x00-\\x1f\\x7f-\\x9f\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff;|&$`<>\\\\*?\"'{}\\[\\]!]{1,255})+$"
      }
    }
  },
  "confirm_template": "{repo_path} Terminal'de açılsın mı?"
}
