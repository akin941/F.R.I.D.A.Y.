{
  "name": "ax.press",
  "version": 1,
  "class": "gate",
  "label": "Arayüz öğesine bas",
  "data_class": "personal",
  "description": "Presses one Accessibility element of an app on the node's local list.",
  "path_args": [],
  "workspace_resolution": "personal_only",
  "max_result_bytes": 16,
  "max_runtime_seconds": 10,
  "streams_output": false,
  "confirm_template": "{bundle_id} uygulamasında '{title}' ({role}) öğesine basılsın mı?",
  "args_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "bundle_id",
      "role",
      "title"
    ],
    "properties": {
      "bundle_id": {
        "type": "string",
        "minLength": 3,
        "maxLength": 155,
        "pattern": "^[A-Za-z0-9-]{1,63}(?:\\.[A-Za-z0-9-]{1,63}){1,7}$"
      },
      "role": {
        "type": "string",
        "enum": [
          "button",
          "menu_item",
          "checkbox"
        ],
        "maxLength": 16
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]{1,120}$"
      }
    }
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "null"
  }
}
