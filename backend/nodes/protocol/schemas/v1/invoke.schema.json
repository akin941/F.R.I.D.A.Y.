{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "server -> node: a signed invocation of one catalogue entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "args_sha256",
    "capability",
    "capability_version",
    "class",
    "expires_at",
    "grant",
    "id",
    "invocation_id",
    "issued_at",
    "key_id",
    "node_id",
    "nonce",
    "sig",
    "trace_id",
    "type",
    "v",
    "workspace_id"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "invoke",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,3}$"
    },
    "capability_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "class": {
      "type": "string",
      "enum": [
        "read",
        "confirm",
        "gate"
      ],
      "maxLength": 16
    },
    "args": {
      "type": "object",
      "x-friday-opaque": "validated by the node against its OWN args_schema (D5 check 15)",
      "maxProperties": 32
    },
    "args_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "grant": {
      "type": [
        "null",
        "object"
      ],
      "x-friday-opaque": "reserved for the Phase 10 approval-bound grant; a v1 node refuses non-null (D5 check 13, class_not_allowed)",
      "maxProperties": 16
    },
    "key_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}$"
    },
    "sig": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
