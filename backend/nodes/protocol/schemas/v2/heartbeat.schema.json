{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node -> server: every heartbeat_seconds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "seq",
    "spool_bytes",
    "spool_count",
    "type",
    "uptime_seconds",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 2
    },
    "type": {
      "type": "string",
      "const": "heartbeat",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spool_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "spool_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 104857600
    }
  }
}
