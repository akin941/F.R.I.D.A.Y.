{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "server -> node: the session ends (a reason and nothing else)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reason",
    "type",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 2
    },
    "type": {
      "type": "string",
      "const": "bye",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "revoked",
        "kill_switch",
        "credential_expired",
        "replaced",
        "protocol_error",
        "server_shutdown"
      ],
      "maxLength": 32
    }
  }
}
