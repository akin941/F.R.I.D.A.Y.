      "category": "read_denied",
      "plant": {"canary": "{home}/Library/Containers/ai.friday.node/Data/credential"},
      "attempt": {"kind": "read", "path": "{home}/Library/Containers/ai.friday.node/Data/credential"},
      "script": "cat '{home}/Library/Containers/ai.friday.node/Data/credential' 2>/dev/null | grep -q '{canary}' && echo FRIDAY-ESCAPED"
