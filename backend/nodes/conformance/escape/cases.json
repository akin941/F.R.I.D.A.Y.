{
  "description": "Friday Node srt escape suite (Phase 10 brief D11, ADR-014 decision 3). Each case is a tiny POSIX sh script run as a mapped `test` command in worktree mode. A case is CONTAINED when the script cannot do what it tries: it prints FRIDAY-ESCAPED only if the attempt succeeded, and the runner also checks side effects (a write target must not exist afterwards, the worktree must be gone, `git worktree list` unchanged). Placeholders: {home} the node's home, {repo} the source repo root, {repo_parent} its parent, {worktree} the throwaway worktree, {run} a per-run id, {canary} the planted canary text, {loopback_port} a listener the runner opens on 127.0.0.1, {hook_socket} the node's hook socket. `attempt` is the static model the fake sandbox checks against the generated policy.",
  "version": 1,
  "cases": [
    {
      "id": "write_home",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "{home}/friday-escape-{run}-home"},
      "script": "echo x > '{home}/friday-escape-{run}-home' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_repo_parent",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "{repo_parent}/friday-escape-{run}-parent"},
      "script": "echo x > '{repo_parent}/friday-escape-{run}-parent' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_source_repo",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "{repo}/friday-escape-{run}-source"},
      "script": "echo x > '{repo}/friday-escape-{run}-source' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_tmp",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "/tmp/friday-escape-{run}-tmp"},
      "script": "echo x > '/tmp/friday-escape-{run}-tmp' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_private_tmp",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "/private/tmp/friday-escape-{run}-ptmp"},
      "script": "echo x > '/private/tmp/friday-escape-{run}-ptmp' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_through_worktree_symlink",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "{home}/friday-escape-{run}-wtlink", "via_symlink": "{worktree}/out"},
      "script": "ln -s '{home}' ./out 2>/dev/null; echo x > ./out/friday-escape-{run}-wtlink 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_through_tmp_symlink",
      "category": "write_outside",
      "plant": {"symlink": "/tmp/friday-escape-{run}-planted", "to": "{home}"},
      "attempt": {"kind": "write", "path": "{home}/friday-escape-{run}-tmplink", "via_symlink": "/tmp/friday-escape-{run}-planted"},
      "script": "echo x > '/tmp/friday-escape-{run}-planted/friday-escape-{run}-tmplink' 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "write_worktree_git",
      "category": "write_outside",
      "attempt": {"kind": "write", "path": "{worktree}/.git"},
      "script": "echo '[core] hooksPath = /tmp' >> ./.git 2>/dev/null && echo FRIDAY-ESCAPED"
    },
    {
      "id": "read_ssh",
      "category": "read_denied",
      "plant": {"canary": "{home}/.ssh/id_ed25519"},
      "attempt": {"kind": "read", "path": "{home}/.ssh/id_ed25519"},
      "script": "cat '{home}/.ssh/id_ed25519' 2>/dev/null | grep -q '{canary}' && echo FRIDAY-ESCAPED"
    },
    {
      "id": "read_aws",
      "category": "read_denied",
      "plant": {"canary": "{home}/.aws/credentials"},
      "attempt": {"kind": "read", "path": "{home}/.aws/credentials"},
      "script": "cat '{home}/.aws/credentials' 2>/dev/null | grep -q '{canary}' && echo FRIDAY-ESCAPED"
    },
    {
