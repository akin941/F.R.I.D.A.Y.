      "script": "cat '{home}/.friday-node/policy.json' 2>/dev/null | grep -q '{canary}' && echo FRIDAY-ESCAPED"
    },
    {
      "id": "net_tcp",
      "category": "network",
      "attempt": {"kind": "network", "proto": "tcp", "host": "1.1.1.1", "port": 443},
      "script": "python3 -c \"import socket; s=socket.create_connection(('1.1.1.1', 443), 3); print('FRIDAY-ESCAPED')\" 2>/dev/null"
    },
    {
      "id": "net_udp",
      "category": "network",
      "attempt": {"kind": "network", "proto": "udp", "host": "1.1.1.1", "port": 53},
      "script": "python3 -c \"import socket; s=socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(3); s.sendto(b'\\x00\\x01\\x01\\x00\\x00\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x07example\\x03com\\x00\\x00\\x01\\x00\\x01', ('1.1.1.1', 53)); s.recvfrom(512); print('FRIDAY-ESCAPED')\" 2>/dev/null"
    },
    {
      "id": "net_dns",
      "category": "network",
      "attempt": {"kind": "network", "proto": "dns", "host": "example.com", "port": 53},
      "script": "python3 -c \"import socket; socket.getaddrinfo('example.com', 443); print('FRIDAY-ESCAPED')\" 2>/dev/null"
    },
    {
      "id": "net_loopback",
      "category": "network",
      "attempt": {"kind": "network", "proto": "loopback", "host": "127.0.0.1", "port": "{loopback_port}"},
      "script": "python3 -c \"import socket; s=socket.create_connection(('127.0.0.1', {loopback_port}), 3); print('FRIDAY-ESCAPED')\" 2>/dev/null"
    },
    {
      "id": "net_hook_socket",
      "category": "network",
      "plant": {"unix_socket": "{hook_socket}"},
      "attempt": {"kind": "unix_socket", "path": "{hook_socket}"},
      "script": "python3 -c \"import socket; s=socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect('{hook_socket}'); print('FRIDAY-ESCAPED')\" 2>/dev/null"
    },
    {
      "id": "env_github_token",
      "category": "environment",
      "attempt": {"kind": "env", "name": "GITHUB_TOKEN"},
      "script": "[ -n \"${GITHUB_TOKEN:-}\" ] && echo FRIDAY-ESCAPED; env | grep -q '{canary}' && echo FRIDAY-ESCAPED; true"
    },
    {
      "id": "limit_processes",
      "category": "limits",
      "attempt": {"kind": "limit", "limit": "max_processes", "want": 400},
      "script": "n=0; while [ $n -lt 400 ]; do sleep 2 & [ $? -eq 0 ] || break; n=$((n+1)); done; [ $n -ge 400 ] && echo FRIDAY-ESCAPED; kill $(jobs -p) 2>/dev/null; true"
    },
    {
      "id": "limit_output",
      "category": "limits",
      "attempt": {"kind": "limit", "limit": "max_output_bytes", "want": 2097152},
      "script": "head -c 2097152 /dev/zero | tr '\\0' 'y'"
    },
    {
      "id": "limit_runtime",
      "category": "limits",
      "runtime_seconds": 2,
      "attempt": {"kind": "limit", "limit": "wall_seconds", "want": 10},
      "script": "sleep 10; echo FRIDAY-ESCAPED"
    }
  ]
