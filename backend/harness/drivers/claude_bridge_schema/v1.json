{
  "schema_format": "friday-agent-bridge-schema/v1",
  "protocol": "friday-agent-bridge/v1",
  "description": "Friday's own line protocol between the host driver (harness/drivers/claude_agent_sdk.py) and harness/docker/claude_agent_bridge.py inside the Claude Code image. One JSON object per line; every frame carries `type`. Owned by Friday, so it is not provisional; changing it is a new protocol version.",
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "tokens": {"type": "integer", "minimum": 0},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/definitions/tokens"},
        "output_tokens": {"$ref": "#/definitions/tokens"},
        "cache_read_input_tokens": {"$ref": "#/definitions/tokens"},
        "cache_creation_input_tokens": {"$ref": "#/definitions/tokens"}
      },
      "additionalProperties": false
    }
  },
  "host_to_bridge": {
    "initialize": {
      "type": "object",
      "required": ["type", "protocol"],
      "properties": {
        "type": {"const": "initialize"},
        "protocol": {"const": "friday-agent-bridge/v1"}
      },
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "required": ["type", "turn_id", "goal"],
      "properties": {
        "type": {"const": "turn"},
        "turn_id": {"$ref": "#/definitions/id"},
        "goal": {"type": "string"}
      },
      "additionalProperties": false
    },
    "permission_response": {
      "type": "object",
      "required": ["type", "request_id", "decision"],
      "properties": {
        "type": {"const": "permission_response"},
        "request_id": {"$ref": "#/definitions/id"},
        "decision": {"enum": ["allow", "deny"]}
      },
      "additionalProperties": false
    }
  },
  "bridge_to_host": {
    "ready": {
      "type": "object",
      "required": ["type", "protocol", "sdk_version", "policy"],
      "properties": {
        "type": {"const": "ready"},
        "protocol": {"const": "friday-agent-bridge/v1"},
        "sdk_version": {"type": "string", "maxLength": 64},
        "policy": {
          "type": "object",
          "required": ["repo_root", "permission_mode", "setting_sources", "bash_allowed"],
          "properties": {
            "repo_root": {"type": "string"},
            "permission_mode": {"type": "string"},
            "setting_sources": {"type": "array", "items": {"type": "string"}},
            "bash_allowed": {"type": "array", "items": {"type": "string"}, "maxItems": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["type", "turn_id", "text"],
      "properties": {
        "type": {"const": "message"},
        "turn_id": {"$ref": "#/definitions/id"},
        "text": {"type": "string", "maxLength": 100000}
      },
      "additionalProperties": false
    },
    "permission_request": {
      "type": "object",
      "required": ["type", "request_id", "turn_id", "tool_name", "input", "reason"],
      "properties": {
        "type": {"const": "permission_request"},
        "request_id": {"$ref": "#/definitions/id"},
        "turn_id": {"$ref": "#/definitions/id"},
        "tool_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "input": {"type": "object"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["type", "turn_id", "status", "usage", "total_cost_usd"],
      "properties": {
        "type": {"const": "result"},
        "turn_id": {"$ref": "#/definitions/id"},
        "status": {"enum": ["completed", "failed"]},
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/usage"}]},
        "total_cost_usd": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "error": {"type": "string", "maxLength": 100}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["type", "code"],
      "properties": {
        "type": {"const": "error"},
        "code": {"type": "string", "maxLength": 100},
        "detail": {"type": "string", "maxLength": 500}
      },
      "additionalProperties": false
    }
  }
}
