# Friday OS frontend — environment template. Copy to .env.local and fill in.

# Server-only: never exposed to the browser.
BACKEND_API_URL=http://127.0.0.1:8001/api/v1
APP_ORIGIN=http://localhost:3001

# Optional. Defense-in-depth cap for the knowledge file-upload proxy route;
# defaults to 4000000 (4MB) if unset. Keep above the backend's
# KNOWLEDGE_MAX_UPLOAD_BYTES setting (with headroom for multipart framing
# overhead) — the backend setting is the source of truth, not this one.
# KNOWLEDGE_MAX_UPLOAD_BYTES=4000000

# Device pairing LAN gating (Phase 4 branch 2). Only behind a reverse proxy
# that sets the browser's IP in this header (Caddy: `header_up X-Real-IP
# {remote_host}`); leave empty for `next dev` / bare `next start` -- their
# X-Forwarded-For is client-controlled. The shared secret must equal the
# backend's FRIDAY_BFF_SHARED_SECRET. (Deprecated fallback: the pre-rename
# JARVIS_BFF_SHARED_SECRET is still read when this one is empty.)
TRUSTED_CLIENT_IP_HEADER=
FRIDAY_BFF_SHARED_SECRET=

# OpenAI-compatible facade passthrough (/v1, Phase 4 branch 6). Failed
# authentications per minute before a source gets 429 without reaching
# Django: per trusted client IP (needs TRUSTED_CLIENT_IP_HEADER), else one
# install-wide bucket. And the largest request body forwarded.
# FACADE_PREAUTH_FAILURES_PER_SOURCE=20
# FACADE_PREAUTH_FAILURES_GLOBAL=60
# FACADE_MAX_BODY_BYTES=4000000
